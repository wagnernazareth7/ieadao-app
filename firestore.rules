rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🛡️ FUNÇÕES AUXILIARES DE ALTA PERFORMANCE
    // ==========================================
    
    function isLogged() {
      return request.auth != null;
    }

    function getMyRoles() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.get('roles', [userDoc.data.get('role', 'membro')]);
    }

    function hasRole(role) {
      let roles = getMyRoles();
      return roles.hasAny([role, role.upper(), 'Administrador', 'Admin', 'admin']);
    }

    function isAdmin() {
      return isLogged() && (hasRole('admin') || hasRole('administrador'));
    }

    function isLeader() {
      return isLogged() && (
        isAdmin() || 
        getMyRoles().hasAny([
          'direcao', 'direção', 'diretor', 'diretora', 'diretoria', 
          'dirigente', 'Direção', 'Direcao', 'Diretor'
        ])
      );
    }

    // ==========================================
    // 📸 MURAL DO CULTO (HIGHLIGHTS)
    // ==========================================
    match /highlights/{id} {
      allow read: if isLogged();
      allow write: if isAdmin() || hasRole('comunicacao');
    }

    // ==========================================
    // 🙏 PEDIDOS DE ORAÇÃO (MODERAÇÃO)
    // ==========================================
    match /prayer_requests/{id} {
      allow read, create: if isLogged();
      // O autor, Admin ou Equipa de Comunicação podem editar/apagar
      allow update, delete: if isLogged() && (
        request.auth.uid == resource.data.userId || 
        isAdmin() || 
        hasRole('comunicacao')
      );
    }

    // ==========================================
    // 📢 AVISOS E COMUNICADOS
    // ==========================================
    match /notices/{noticeId} {
      allow read: if isLogged();
      allow write: if isAdmin() || hasRole('comunicacao');
      match /replies/{replyId} {
        allow read, create: if isLogged();
        allow delete: if isAdmin() || hasRole('comunicacao') || (isLogged() && request.auth.uid == resource.data.userId);
      }
    }

    // ==========================================
    // 📺 TRANSMISSÃO AO VIVO
    // ==========================================
    match /live_stream/{id} {
      allow read: if isLogged();
      allow write: if isAdmin() || hasRole('comunicacao');
    }

    // ==========================================
    // 🙏 SOLICITAÇÃO DE VISITAS
    // ==========================================
    match /visit_requests/{id} {
      allow read: if isLogged() && (request.auth.uid == resource.data.userId || isLeader());
      allow create: if isLogged();
      allow update, delete: if isLeader();
    }

    // ==========================================
    // 📜 AUDITORIA
    // ==========================================
    match /audit_logs/{logId} {
      allow create: if isLogged(); 
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ==========================================
    // 🧱 EBD (ESCOLA DOMINICAL)
    // ==========================================
    match /ebd_classes/{id} {
      allow read: if isLogged();
      allow write: if isLeader() || hasRole('secretaria');
    }

    match /ebd_attendance/{id} {
      allow read: if isLogged();
      allow write: if isLeader() || hasRole('professor');
    }

    match /ebd_certificates/{id} {
      allow read: if isLogged() && (request.auth.uid == resource.data.userId || isLeader());
      allow write: if isLeader();
    }

    // ==========================================
    // 👥 MEMBROS E ACESSOS
    // ==========================================
    match /membros/{id} {
      allow read: if isLogged();
      allow create: if isLeader() || (isLogged() && request.auth.uid == id);
      allow update: if isLeader() || hasRole('secretaria') || (isLogged() && request.auth.uid == id);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isLogged();
      allow write: if isAdmin() || hasRole('direcao') || (isLogged() && request.auth.uid == userId);
    }

    // ==========================================
    // 📅 EVENTOS
    // ==========================================
    match /eventos/{id} {
      allow read: if isLogged();
      allow write: if isLeader() || hasRole('secretaria') || hasRole('comunicacao');
    }

    // ================= =========================
    // 📓 OUTRAS REGRAS
    // ==========================================
    match /journal_entries/{id} {
      allow read, write: if isLogged() && request.auth.uid == (resource == null ? request.resource.data.userId : resource.data.userId);
    }

    match /donations/{id} {
      allow read: if isLogged() && (isAdmin() || hasRole('direcao') || hasRole('diretor'));
      allow create: if isLogged();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
